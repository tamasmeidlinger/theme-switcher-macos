#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"
sketchybar --bar position=top height=32 blur_radius=30 color=0xff292c35 padding_left=6 padding_right=4

default=(
  padding_left=0
  padding_right=0
  padding_top=0
  padding_bottom=0
  icon.font="CaskaydiaMono Nerd Font:Regular:16.0"
  label.font="CaskaydiaMono Nerd Font:Regular:14.0"
  icon.color=0xffCAC6B2
  label.color=0xffCAC6B2
  background.color=0xff292c35
  background.corner_radius=5
  background.height=24
  background.padding_left=5
  background.padding_right=5
  background.padding_top=0
  background.padding_bottom=0
  background.border_width=1
  background.border_color=0xff6B8CA9
  icon.padding_left=8
  icon.padding_right=5
  label.padding_left=5
  label.padding_right=8
)
sketchybar --default "${default[@]}"

# -- Right Side Items --
sketchybar --add item calendar right \
  --set calendar icon="󰃰" \
  padding_left=0 \
  update_freq=20 \
  script="$PLUGIN_DIR/calendar.sh"

source $ITEM_DIR/volume.sh
source $ITEM_DIR/battery.sh

# -- Left Side Items --
source $ITEM_DIR/aerospace.sh
source $ITEM_DIR/front_app.sh

sketchybar --update
